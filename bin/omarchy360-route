#!/usr/bin/env python3
# Per-app output routing for the apps page, through pipewire-pulse (pactl).
#
#   omarchy360-route list                 -> JSON {"sinks": [...], "streams": {node-id: sink-name}}
#   omarchy360-route move <node-id> <sink-name>
#
# Apps are PipeWire nodes in the plugin, but pactl numbers its sink inputs
# differently, so streams are matched by their PipeWire object.id. Moving
# through pactl also lets WirePlumber remember the choice for that app.

import json
import subprocess
import sys


def pactl_json(*args):
    try:
        out = subprocess.run(["pactl", "-f", "json", *args], capture_output=True,
                             text=True, timeout=5).stdout
        return json.loads(out or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def listing():
    sinks = pactl_json("list", "sinks")
    by_index = {s["index"]: s["name"] for s in sinks}
    streams = {}
    for si in pactl_json("list", "sink-inputs"):
        node = si.get("properties", {}).get("object.id")
        if node is not None and si.get("sink") in by_index:
            streams[str(node)] = by_index[si["sink"]]
    return {
        "sinks": [{"name": s["name"], "description": s.get("description") or s["name"]}
                  for s in sinks],
        "streams": streams,
    }


def move(node_id, sink):
    for si in pactl_json("list", "sink-inputs"):
        if str(si.get("properties", {}).get("object.id")) == node_id:
            r = subprocess.run(["pactl", "move-sink-input", str(si["index"]), sink],
                               capture_output=True, text=True, timeout=5)
            if r.returncode != 0:
                sys.exit("omarchy360-route: " + (r.stderr.strip() or "move failed"))
            return
    sys.exit("omarchy360-route: no playback stream with node id %s" % node_id)


if __name__ == "__main__":
    if len(sys.argv) == 2 and sys.argv[1] == "list":
        print(json.dumps(listing()))
    elif len(sys.argv) == 4 and sys.argv[1] == "move":
        move(sys.argv[2], sys.argv[3])
    else:
        sys.exit("usage: omarchy360-route list | move <node-id> <sink-name>")
